---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import LeadForm from "../components/LeadForm.astro";
import { business } from "../data/business";
import rayPhoto from "../assets/team/ray-allen.jpg";

const values = [
  {
    name: "Integrity",
    description:
      "We'll tell you what a job actually needs — not what pads the invoice. Straight answers, fair pricing, no surprises.",
  },
  {
    name: "Duty",
    description:
      "Once we commit to a job, we see it through. Weather, schedule, whatever comes up — we finish what we started.",
  },
  {
    name: "Excellence",
    description:
      "We hold our work to the same standard Ray learned in uniform: do it right the first time, or do it again until it is.",
  },
];
---

<Layout
  title={`About Us | ${business.brandName}`}
  description={`Meet Ray Allen, owner of ${business.brandName} — an Air Force veteran and Reservist whose family has served North Carolina homeowners for dozens of years.`}
>
  <section class="bg-brand-black py-16 text-center text-white">
    <h1 class="text-4xl font-extrabold sm:text-5xl">Meet Ray Allen</h1>
    <p class="mx-auto mt-4 max-w-2xl px-4 text-white/80">
      Owner of {business.brandName} — veteran, reservist, and part of a family that's been
      serving North Carolina homeowners for dozens of years.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <Image
        src={rayPhoto}
        alt="Ray Allen standing in front of his work truck and trailer"
        widths={[500, 900, 1448]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        class="w-full rounded-lg"
      />
      <div class="space-y-4 text-black/70">
        <p>
          Before he was running a crew, Ray was serving in the U.S. Air Force, stationed at
          Minot Air Force Base in North Dakota. He still serves today in the Air Force
          Reserve. The values he picked up in uniform — integrity, duty, and doing the job
          right even when no one's watching — are the same ones he brings to every property
          {" "}{business.brandName} touches.
        </p>
        <p>
          Home services run in the family. The Allens have been doing this kind of work for
          homeowners across North Carolina for dozens of years, and Ray built
          {" "}{business.brandName} to bring that same hands-on, do-it-right approach to
          general maintenance, landscaping, hauling, and junk removal — all under one roof,
          one call.
        </p>
        <p>
          Ask around and you'll hear the same thing: we don't leave a job half-finished, and
          we don't waste a customer's budget or their time. If we start it, we finish it — the
          right way, the first time.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-black/5 px-4 py-16">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-center text-3xl font-bold text-brand-black">What We Stand On</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        {
          values.map((value) => (
            <div class="rounded-lg border border-black/10 bg-white p-6 text-center shadow-sm">
              <h3 class="text-xl font-semibold text-brand-red">{value.name}</h3>
              <p class="mt-2 text-black/70">{value.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="px-4 py-16">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-center text-3xl font-bold text-brand-black">Work With Us</h2>
      <p class="mx-auto mt-2 max-w-xl text-center text-black/70">
        Tell us what you need and we'll get back to you quickly.
      </p>
      <div class="mt-8">
        <LeadForm sourcePage="about" />
      </div>
    </div>
  </section>
</Layout>
