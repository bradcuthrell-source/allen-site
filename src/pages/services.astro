---
import Layout from "../layouts/Layout.astro";
import LeadForm from "../components/LeadForm.astro";
import { business, services } from "../data/business";
---

<Layout
  title={`Our Services | ${business.brandName}`}
  description={`Full details on the general maintenance, landscaping, hauling, and junk removal services offered by ${business.brandName} in the greater Raleigh, NC area.`}
>
  <section class="bg-brand-black py-16 text-center text-white">
    <h1 class="text-4xl font-extrabold">Our Services</h1>
    <p class="mx-auto mt-4 max-w-2xl px-4 text-white/80">
      Everything you need to maintain and clear out your property, all from one call.
    </p>
  </section>

  <section class="mx-auto max-w-4xl space-y-10 px-4 py-16">
    {
      services.map((service) => (
        <div id={service.slug} class="scroll-mt-24 border-b border-black/10 pb-10 last:border-0">
          <h2 class="text-2xl font-bold text-brand-red">{service.name}</h2>
          <p class="mt-3 text-black/70">{service.description}</p>
        </div>
      ))
    }
  </section>

  <section class="bg-black/5 px-4 py-16">
    <h2 class="text-center text-3xl font-bold text-brand-black">Ready to Get Started?</h2>
    <div class="mt-8">
      <LeadForm sourcePage="services" />
    </div>
  </section>
</Layout>
