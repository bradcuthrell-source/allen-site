---
import Layout from "../layouts/Layout.astro";
import LeadForm from "../components/LeadForm.astro";
import { business, services, processSteps } from "../data/business";
---

<Layout
  title={`Our Services | ${business.brandName}`}
  description={`Full details on the general maintenance, landscaping, hauling, and junk removal services offered by ${business.brandName} in the greater Raleigh, NC area.`}
>
  <section class="bg-brand-black py-16 text-center text-white">
    <h1 class="text-4xl font-extrabold">Our Services</h1>
    <p class="mx-auto mt-4 max-w-2xl px-4 text-white/80">
      Everything you need to maintain and clear out your property, all from one call.
    </p>
  </section>

  <section class="mx-auto max-w-4xl space-y-12 px-4 py-16">
    {
      services.map((service) => (
        <div id={service.slug} class="scroll-mt-24 border-b border-black/10 pb-12 last:border-0">
          <h2 class="text-2xl font-bold text-brand-red">{service.name}</h2>
          <p class="mt-3 text-black/70">{service.description}</p>
          <ul class="mt-4 grid gap-x-6 gap-y-2 text-black/70 sm:grid-cols-2">
            {service.details.map((detail) => (
              <li class="flex gap-2">
                <span class="text-brand-red" aria-hidden="true">
                  ✓
                </span>
                <span>{detail}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <section class="bg-black/5 px-4 py-16">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-center text-3xl font-bold text-brand-black">How It Works</h2>
      <p class="mx-auto mt-2 max-w-xl text-center text-black/70">
        From the first call to the last load hauled off, here's what to expect.
      </p>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          processSteps.map((step, i) => (
            <div class="rounded-lg border border-black/10 bg-white p-6">
              <span class="text-3xl font-extrabold text-brand-red/30">{i + 1}</span>
              <h3 class="mt-2 text-lg font-semibold text-brand-black">{step.title}</h3>
              <p class="mt-2 text-sm text-black/70">{step.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="px-4 py-16">
    <h2 class="text-center text-3xl font-bold text-brand-black">Ready to Get Started?</h2>
    <div class="mt-8">
      <LeadForm sourcePage="services" />
    </div>
  </section>
</Layout>
