---
import Layout from "../layouts/Layout.astro";
import { business } from "../data/business";
---

<Layout
  title={`Thank You | ${business.brandName}`}
  description="Thanks for reaching out — we'll be in touch shortly."
  noindex
>
  <section class="mx-auto max-w-2xl px-4 py-24 text-center">
    <h1 class="text-4xl font-extrabold text-brand-black">Thanks for Reaching Out!</h1>
    <p class="mt-4 text-lg text-black/70">
      We've received your request and will get back to you within one business day. If it's urgent, give us a
      call directly.
    </p>
    <a
      href={business.phoneHref}
      class="mt-8 inline-block rounded-md bg-brand-red px-6 py-3 text-lg font-semibold text-white transition hover:bg-brand-red-dark"
    >
      📞 Call {business.phoneDisplay}
    </a>
    <p class="mt-8">
      <a href="/" class="text-brand-red hover:underline">&larr; Back to Home</a>
    </p>
  </section>
</Layout>
