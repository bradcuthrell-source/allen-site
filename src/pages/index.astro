---
import Layout from "../layouts/Layout.astro";
import ServicesGrid from "../components/ServicesGrid.astro";
import LeadForm from "../components/LeadForm.astro";
import ComingSoon from "../components/ComingSoon.astro";
import { business } from "../data/business";
import { cities } from "../data/cities";

const featuredCities = cities.slice(0, 8);

const faqs = [
  {
    question: "What areas do you serve?",
    answer: `We serve homes and businesses within a ${business.serviceAreaRadiusMiles}-mile radius of ${business.serviceAreaCenter}, covering Wake County and nearby areas. See our full service area list for details.`,
  },
  {
    question: "What services do you offer?",
    answer:
      "General maintenance, landscaping, hauling, and junk removal — one call covers all four.",
  },
  {
    question: "Do you offer free quotes?",
    answer: "Yes. Call us or fill out the form on this page and we'll follow up with pricing.",
  },
  {
    question: "How quickly can you respond to my request?",
    answer:
      "We follow up on quote requests within one business day. For the fastest response, give us a call directly.",
  },
  {
    question: "Do I need to be home for an estimate?",
    answer:
      "For many jobs we can put together an estimate over the phone. Larger projects may benefit from an in-person walkthrough.",
  },
];
---

<Layout
  title={`${business.brandName} | Maintenance, Landscaping & Hauling in Raleigh, NC`}
  description={`${business.brandName} provides general maintenance, landscaping, hauling, and junk removal across the greater Raleigh, NC area. Call now for a free quote.`}
>
  <section class="bg-brand-black text-white">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-20 lg:grid-cols-2">
      <div>
        <h1 class="text-4xl font-extrabold leading-tight sm:text-5xl">
          Reliable Maintenance, Landscaping &amp; Hauling — Raleigh &amp; Beyond
        </h1>
        <p class="mt-4 text-lg text-white/80">
          General maintenance, landscaping, hauling, and junk removal — serving homes and
          businesses within {business.serviceAreaRadiusMiles} miles of {business.serviceAreaCenter}.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href={business.phoneHref}
            class="rounded-md bg-brand-red px-6 py-3 text-lg font-semibold text-white transition hover:bg-brand-red-dark"
          >
            📞 Call Now — {business.phoneDisplay}
          </a>
          <a
            href="#quote"
            class="rounded-md border border-white/30 px-6 py-3 text-lg font-semibold text-white transition hover:bg-white/10"
          >
            Get a Free Quote
          </a>
        </div>

        <div class="mt-10 grid grid-cols-3 gap-4 border-t border-white/10 pt-6">
          <div>
            <p class="text-2xl font-bold text-brand-red">4</p>
            <p class="mt-1 text-sm text-white/70">Services Under One Roof</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-brand-red">{business.serviceAreaRadiusMiles} mi</p>
            <p class="mt-1 text-sm text-white/70">Radius Around Raleigh</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-brand-red">Local</p>
            <p class="mt-1 text-sm text-white/70">Locally Owned &amp; Operated</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ServicesGrid showLearnMore />

  <section class="bg-black/5">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 lg:grid-cols-2">
      <div>
        <p class="text-sm font-bold uppercase tracking-wider text-brand-red">About Us</p>
        <h2 class="mt-2 text-3xl font-bold text-brand-black">
          One Local Team for Maintenance, Landscaping &amp; Hauling
        </h2>
        <p class="mt-4 text-black/70">
          {business.brandName} is a locally owned, full-service operation covering general
          maintenance, landscaping, hauling, and junk removal across the greater{" "}
          {business.serviceAreaCenter} area. Instead of juggling calls to several different
          contractors, one call to us covers it all.
        </p>
      </div>
      <ComingSoon
        label="Owner & Crew Photo"
        note="A real photo of Allen and the crew will go here once we have one."
      />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-center text-3xl font-bold text-brand-black">Recent Work</h2>
    <p class="mx-auto mt-2 max-w-xl text-center text-black/70">
      Real before/after photos from completed jobs will live here.
    </p>
    <div class="mt-8">
      <ComingSoon
        label="Project Photos"
        note="Send us a few before/after photos from recent jobs and we'll build out a project gallery."
      />
    </div>
  </section>

  <section class="bg-black/5 px-4 py-16">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-center text-3xl font-bold text-brand-black">What Customers Say</h2>
      <p class="mx-auto mt-2 max-w-xl text-center text-black/70">
        Google reviews will be featured here once we've built up a review history.
      </p>
      <div class="mt-8">
        <ComingSoon
          label="Customer Reviews"
          note="Claim the Google Business Profile and collect a few reviews — then this section becomes a review carousel."
        />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-center text-3xl font-bold text-brand-black">Proudly Serving the Triangle</h2>
    <p class="mx-auto mt-2 max-w-xl text-center text-black/70">
      A few of the communities we serve — see the full list of {cities.length}+ areas.
    </p>
    <div class="mx-auto mt-8 flex max-w-3xl flex-wrap justify-center gap-3">
      {
        featuredCities.map((city) => (
          <a
            href={`/service-area/${city.slug}`}
            class="rounded-full border border-black/20 px-4 py-2 text-sm font-medium hover:border-brand-red hover:text-brand-red"
          >
            {city.name}, NC
          </a>
        ))
      }
    </div>
    <div class="mt-6 text-center">
      <a href="/service-area" class="font-semibold text-brand-red hover:underline">
        View All Service Areas →
      </a>
    </div>
  </section>

  <section class="bg-black/5 px-4 py-16">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-center text-3xl font-bold text-brand-black">Frequently Asked Questions</h2>
      <div class="mt-8 space-y-3">
        {
          faqs.map((faq) => (
            <details class="group rounded-lg border border-black/10 bg-white p-4 open:shadow-sm">
              <summary class="cursor-pointer list-none font-semibold text-brand-black marker:content-none">
                <span class="flex items-center justify-between gap-4">
                  {faq.question}
                  <span class="text-brand-red transition group-open:rotate-45">+</span>
                </span>
              </summary>
              <p class="mt-3 text-black/70">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-center text-3xl font-bold text-brand-black">Meet the Team</h2>
    <p class="mx-auto mt-2 max-w-xl text-center text-black/70">
      Names, roles, and photos of the crew will go here.
    </p>
    <div class="mt-8">
      <ComingSoon
        label="Team Bios"
        note="Send crew names, roles, and headshots and we'll build out a team section."
      />
    </div>
  </section>

  <section id="quote" class="bg-brand-black px-4 py-16 text-white">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-center text-3xl font-bold">Get Your Free Quote</h2>
      <p class="mx-auto mt-2 max-w-xl text-center text-white/70">
        Tell us what you need and we'll get back to you quickly.
      </p>
      <ul class="mx-auto mt-6 flex max-w-xl flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-white/70">
        <li>✓ Free Quotes</li>
        <li>✓ Locally Owned</li>
        <li>✓ Full-Service</li>
        <li>✓ Serving the Triangle</li>
      </ul>
      <div class="mt-8">
        <LeadForm sourcePage="home" />
      </div>
    </div>
  </section>
</Layout>
