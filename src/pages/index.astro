---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import ServicesGrid from "../components/ServicesGrid.astro";
import LeadForm from "../components/LeadForm.astro";
import ValueProps from "../components/ValueProps.astro";
import PhoneIcon from "../components/icons/PhoneIcon.astro";
import { business, valueProps } from "../data/business";
import { cities } from "../data/cities";
import heroImage from "../assets/hero-illustration.png";
import yardCleanupBefore from "../assets/work/yard-cleanup-before.jpg";
import yardCleanupAfter from "../assets/work/yard-cleanup-after.jpg";
import kitchenFlooring from "../assets/work/kitchen-flooring.jpg";
import counterInstall from "../assets/work/ray-maintenance.jpg";
import brushHauling from "../assets/work/brush-hauling.jpg";
import rayPhoto from "../assets/team/ray-allen.jpg";

const featuredCities = cities.slice(0, 8);

const testimonials = [
  {
    quote: [
      "I had a great experience with Allen's Pro Services. My backyard had gotten pretty overgrown, and they did a great job trimming trees and bushes, clearing out a ton of brush and overgrowth, and hauling everything away when he was finished.",
      "The difference was night and day. I honestly didn't realize how much usable space we had in our backyard until everything was cleared out. It looks bigger, cleaner, and completely transformed. The guy who came out was super nice, worked hard, did a thorough job, and left everything looking great. I've already recommended them to my neighbors!",
    ],
    author: "Brad C.",
  },
  {
    quote: [
      "Ray did such an amazing job transforming my garden area into a relaxing masterpiece for me to enjoy.",
      "He truly took a dull area of my yard and made it a place for my whole family and myself to enjoy. Thank you for listening to my wants and making them a reality!",
    ],
    author: "Julia C.",
  },
];

const recentWork = [
  {
    src: kitchenFlooring,
    alt: "New wood-look plank flooring installed in a kitchen",
    caption: "Kitchen flooring installation",
  },
  {
    src: counterInstall,
    alt: "Crew member fitting a mounted glass-front hutch above a kitchen counter",
    caption: "Mounted hutch installation",
  },
  {
    src: brushHauling,
    alt: "Utility trailer loaded with tree limbs and brush at a yard-waste site",
    caption: "Storm debris & brush hauled off",
  },
];

const faqs = [
  {
    question: "What areas do you serve?",
    answer: `We serve homes and businesses within a ${business.serviceAreaRadiusMiles}-mile radius of ${business.serviceAreaCenter}, covering Wake County and nearby areas. See our full service area list for details.`,
  },
  {
    question: "What services do you offer?",
    answer:
      "General maintenance, landscaping, hauling, and junk removal — one call covers all four.",
  },
  {
    question: "Do you offer free quotes?",
    answer: "Yes. Call us or fill out the form on this page and we'll follow up with pricing.",
  },
  {
    question: "How quickly can you respond to my request?",
    answer:
      "We follow up on quote requests within one business day. For the fastest response, give us a call directly.",
  },
  {
    question: "Do I need to be home for an estimate?",
    answer:
      "For many jobs we can put together an estimate over the phone. Larger projects may benefit from an in-person walkthrough.",
  },
];
---

<Layout
  title={`${business.brandName} | Maintenance, Landscaping & Hauling in Raleigh, NC`}
  description={`${business.brandName} provides general maintenance, landscaping, hauling, and junk removal across the greater Raleigh, NC area. Call now for a free quote.`}
>
  <section class="border-b border-black/10 bg-white text-brand-black">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 pb-20 pt-10 lg:grid-cols-2">
      <div>
        <h1 class="text-4xl font-extrabold leading-tight text-brand-black sm:text-5xl">
          Reliable Maintenance, Landscaping &amp; Hauling — Raleigh &amp; Beyond
        </h1>
        <p class="mt-4 text-lg text-black/70">
          General maintenance, landscaping, hauling, and junk removal — serving homes and
          businesses within {business.serviceAreaRadiusMiles} miles of {business.serviceAreaCenter}.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href={business.phoneHref}
            class="inline-flex items-center gap-2 rounded-md bg-brand-red px-6 py-3 text-lg font-semibold text-white transition hover:bg-brand-red-dark"
          >
            <PhoneIcon class="h-5 w-5" />
            Call Now
          </a>
          <a
            href="#quote"
            class="rounded-md border border-brand-red/40 px-6 py-3 text-lg font-semibold text-brand-red transition hover:bg-brand-red/5"
          >
            Get a Free Quote
          </a>
        </div>

        <div class="mt-10 grid grid-cols-3 gap-4 border-t border-black/10 pt-6">
          <div>
            <p class="text-2xl font-bold text-brand-red">4</p>
            <p class="mt-1 text-sm text-black/60">Services Under One Roof</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-brand-red">{business.serviceAreaRadiusMiles} mi</p>
            <p class="mt-1 text-sm text-black/60">Radius Around Raleigh</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-brand-red">Local</p>
            <p class="mt-1 text-sm text-black/60">Locally Owned &amp; Operated</p>
          </div>
        </div>
      </div>

      <div class="hidden lg:block lg:-mr-[5vw] xl:-mr-[9vw]">
        <Image
          src={heroImage}
          alt={`${business.brandName} crew mowing, painting, plumbing, and hauling junk beneath a rooftop formed by the ${business.brandName} "A" logo`}
          widths={[550, 800, 1100, 1536]}
          sizes="(min-width: 1024px) 640px, 100vw"
          loading="eager"
          class="w-full"
        />
        <p class="mx-auto -mt-3 max-w-sm text-center text-lg font-bold leading-snug text-brand-black xl:text-xl">
          For all your home and business needs{" "}
          <span class="whitespace-nowrap">— <span class="text-brand-red">we've got you covered</span></span>
        </p>
      </div>
    </div>
  </section>

  <ValueProps />

  <ServicesGrid showLearnMore tinted />

  <section>
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 lg:grid-cols-2">
      <div>
        <p class="text-sm font-bold uppercase tracking-wider text-brand-red">About Us</p>
        <h2 class="mt-2 text-3xl font-bold text-brand-black">
          Run by a Veteran, Backed by a Family Business
        </h2>
        <p class="mt-4 text-black/70">
          {business.brandName} is owned and operated by Ray Allen, an Air Force veteran and
          current reservist whose family has served North Carolina homeowners for dozens of
          years. Ray brings the same integrity, duty, and excellence he learned in uniform to
          every maintenance, landscaping, hauling, and junk removal job we take on.
        </p>
        <a href="/about" class="mt-4 inline-block font-semibold text-brand-red hover:underline">
          Read Ray's Story →
        </a>
      </div>
      <Image
        src={rayPhoto}
        alt="Ray Allen, owner of Allen's Pro Services, standing in front of his work truck and trailer"
        widths={[500, 900, 1200]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        class="w-full rounded-lg"
      />
    </div>
  </section>

  <section class="bg-black/5 px-4 py-16">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-center text-3xl font-bold text-brand-black">Recent Work</h2>
      <p class="mx-auto mt-2 max-w-xl text-center text-black/70">
        A few recent jobs around the Triangle — maintenance, flooring, yard cleanups, and hauling.
      </p>

      <figure class="mt-10">
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="relative overflow-hidden rounded-lg border border-black/10">
            <Image
              src={yardCleanupBefore}
              alt="Overgrown wooded backyard with a brush pile before cleanup"
              widths={[480, 960, 1200]}
              sizes="(min-width: 640px) 50vw, 100vw"
              class="aspect-[4/3] w-full object-cover"
            />
            <span class="absolute left-3 top-3 rounded bg-brand-black/80 px-2 py-1 text-xs font-bold uppercase tracking-wide text-white">
              Before
            </span>
          </div>
          <div class="relative overflow-hidden rounded-lg border border-black/10">
            <Image
              src={yardCleanupAfter}
              alt="The same backyard cleared and mulched with a new fire pit and chairs"
              widths={[480, 960, 1200]}
              sizes="(min-width: 640px) 50vw, 100vw"
              class="aspect-[4/3] w-full object-cover"
            />
            <span class="absolute left-3 top-3 rounded bg-brand-red px-2 py-1 text-xs font-bold uppercase tracking-wide text-white">
              After
            </span>
          </div>
        </div>
        <figcaption class="mt-3 text-center text-sm text-black/60">
          Backyard cleanup &amp; fire-pit clearing — Wake County
        </figcaption>
      </figure>

      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        {
          recentWork.map((photo) => (
            <figure class="overflow-hidden rounded-lg border border-black/10">
              <Image
                src={photo.src}
                alt={photo.alt}
                widths={[380, 760, 1140]}
                sizes="(min-width: 640px) 33vw, 100vw"
                class="aspect-[4/3] w-full object-cover"
              />
              <figcaption class="px-4 py-3 text-sm font-medium text-black/70">
                {photo.caption}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="px-4 py-16">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-center text-3xl font-bold text-brand-black">What Customers Say</h2>

      <div class="mx-auto mt-8 grid gap-6 sm:grid-cols-2">
        {
          testimonials.map((review) => (
            <figure class="flex flex-col rounded-lg border border-black/10 bg-white p-8 shadow-sm">
              <div class="flex justify-center gap-0.5 text-brand-red">
                {Array.from({ length: 5 }).map(() => (
                  <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 15.9 4.8 18.6l1-5.8L1.5 8.7l5.9-.9z" />
                  </svg>
                ))}
              </div>
              <span class="sr-only">Rated 5 out of 5 stars</span>
              <blockquote class="mt-5 flex-1 space-y-4 text-black/80">
                {review.quote.map((p) => (
                  <p>{p}</p>
                ))}
              </blockquote>
              <figcaption class="mt-6 text-center text-sm font-semibold text-brand-black">
                — {review.author}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-black/5 px-4 py-16">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-center text-3xl font-bold text-brand-black">Proudly Serving the Triangle</h2>
      <p class="mx-auto mt-2 max-w-xl text-center text-black/70">
        A few of the communities we serve — see the full list of {cities.length}+ areas.
      </p>
      <div class="mx-auto mt-8 flex max-w-3xl flex-wrap justify-center gap-3">
        {
          featuredCities.map((city) => (
            <a
              href={`/service-area/${city.slug}`}
              class="rounded-full border border-black/20 bg-white px-4 py-2 text-sm font-medium hover:border-brand-red hover:text-brand-red"
            >
              {city.name}, NC
            </a>
          ))
        }
      </div>
      <div class="mt-6 text-center">
        <a href="/service-area" class="font-semibold text-brand-red hover:underline">
          View All Service Areas →
        </a>
      </div>
    </div>
  </section>

  <section class="px-4 py-16">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-center text-3xl font-bold text-brand-black">Frequently Asked Questions</h2>
      <div class="mt-8 space-y-3">
        {
          faqs.map((faq) => (
            <details class="group rounded-lg border border-black/10 bg-white p-4 open:shadow-sm">
              <summary class="cursor-pointer list-none font-semibold text-brand-black marker:content-none">
                <span class="flex items-center justify-between gap-4">
                  {faq.question}
                  <span class="text-brand-red transition group-open:rotate-45">+</span>
                </span>
              </summary>
              <p class="mt-3 text-black/70">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section id="quote" class="bg-brand-black px-4 py-16 text-white">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-center text-3xl font-bold">Get Your Free Quote</h2>
      <p class="mx-auto mt-2 max-w-xl text-center text-white/70">
        Tell us what you need and we'll get back to you quickly.
      </p>
      <ul class="mx-auto mt-6 flex max-w-xl flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-white/70">
        {valueProps.map((prop) => <li>✓ {prop}</li>)}
      </ul>
      <div class="mt-8">
        <LeadForm sourcePage="home" />
      </div>
    </div>
  </section>
</Layout>
