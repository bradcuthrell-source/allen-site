---
import Layout from "../../layouts/Layout.astro";
import ServicesGrid from "../../components/ServicesGrid.astro";
import ValueProps from "../../components/ValueProps.astro";
import LeadForm from "../../components/LeadForm.astro";
import { business } from "../../data/business";
import { cities, type City } from "../../data/cities";
import { cityStats } from "../../data/cityStats";
import { cityHousingCopy } from "../../lib/cityCopy";
import { cityServiceBlocks, cityWhyUsCopy, cityFaqs } from "../../lib/cityServiceCopy";
import PhoneIcon from "../../components/icons/PhoneIcon.astro";

export function getStaticPaths() {
  return cities.map((city) => ({
    params: { city: city.slug },
    props: { city },
  }));
}

interface Props {
  city: City;
}

const { city } = Astro.props;

const nearbyCities = city.nearby
  .map((slug) => cities.find((c) => c.slug === slug))
  .filter((c): c is City => Boolean(c));

const stats = cityStats[city.slug];
const housingCopy = cityHousingCopy(city.name, city.county, stats);
const serviceBlocks = stats ? cityServiceBlocks(city.name, stats) : null;
const whyUsCopy = stats
  ? cityWhyUsCopy(city.name, city.county, business.serviceAreaRadiusMiles, stats, nearbyCities)
  : null;
const faqs = stats
  ? cityFaqs(city.name, city.county, business.serviceAreaRadiusMiles, stats, nearbyCities)
  : null;
---

<Layout
  title={`Handyman & Landscaping in ${city.name}, NC | ${business.brandName}`}
  description={`${business.brandName} provides general maintenance, landscaping, hauling, and junk removal in ${city.name}, NC and surrounding ${city.county} County areas.`}
>
  <section class="bg-brand-black py-16 text-center text-white">
    <h1 class="text-4xl font-extrabold sm:text-5xl">
      Maintenance, Landscaping &amp; Hauling in {city.name}, NC
    </h1>
    <p class="mx-auto mt-4 max-w-2xl px-4 text-white/80">
      {business.brandName} proudly serves {city.name} and the rest of {city.county} County with general
      maintenance, landscaping, hauling, and junk removal.
    </p>
    <a
      href={business.phoneHref}
      class="mt-8 inline-flex items-center gap-2 rounded-md bg-brand-red px-6 py-3 text-lg font-semibold text-white transition hover:bg-brand-red-dark"
    >
      <PhoneIcon class="h-5 w-5" />
      Call Now — {business.phoneDisplay}
    </a>
  </section>

  <ValueProps />

  {
    housingCopy && (
      <section class="bg-black/5 px-4 py-14">
        <div class="mx-auto max-w-3xl">
          <h2 class="text-2xl font-bold text-brand-black">
            Home &amp; Yard Upkeep in {city.name}
          </h2>
          <div class="mt-4 space-y-4 text-black/70">
            {housingCopy.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
          </div>
          <p class="mt-4 text-xs text-black/40">{housingCopy.source}</p>
        </div>
      </section>
    )
  }

  {
    serviceBlocks && (
      <section class="px-4 py-14">
        <div class="mx-auto max-w-3xl">
          <h2 class="text-2xl font-bold text-brand-black">Services in {city.name}</h2>
          <div class="mt-6 space-y-6">
            {serviceBlocks.map((service) => (
              <div>
                <h3 class="text-lg font-semibold text-brand-red">
                  {service.name} in {city.name}
                </h3>
                <p class="mt-1 text-black/70">{service.paragraph}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <ServicesGrid heading={`Services Available in ${city.name}`} tinted />

  {
    whyUsCopy && (
      <section class="px-4 py-14">
        <div class="mx-auto max-w-3xl">
          <h2 class="text-2xl font-bold text-brand-black">
            Why {business.brandName} for {city.name}
          </h2>
          <p class="mt-4 text-black/70">{whyUsCopy}</p>
        </div>
      </section>
    )
  }

  {
    nearbyCities.length > 0 && (
      <section class="bg-black/5 px-4 py-12 text-center">
        <h2 class="text-xl font-semibold text-brand-black">Areas We Also Serve Near {city.name}</h2>
        <div class="mx-auto mt-4 flex max-w-2xl flex-wrap justify-center gap-3">
          {nearbyCities.map((nearby) => (
            <a
              href={`/service-area/${nearby.slug}`}
              class="rounded-full border border-black/20 bg-white px-4 py-2 text-sm font-medium hover:border-brand-red hover:text-brand-red"
            >
              {nearby.name}, NC
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    faqs && (
      <section class="px-4 py-14">
        <div class="mx-auto max-w-3xl">
          <h2 class="text-center text-2xl font-bold text-brand-black">
            Frequently Asked Questions — {city.name}
          </h2>
          <div class="mt-6 space-y-3">
            {faqs.map((faq) => (
              <details class="group rounded-lg border border-black/10 bg-white p-4 open:shadow-sm">
                <summary class="cursor-pointer list-none font-semibold text-brand-black marker:content-none">
                  <span class="flex items-center justify-between gap-4">
                    {faq.question}
                    <span class="text-brand-red transition group-open:rotate-45">+</span>
                  </span>
                </summary>
                <p class="mt-3 text-black/70">{faq.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="bg-black/5 px-4 py-16">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-center text-3xl font-bold text-brand-black">
        Get a Free Quote in {city.name}
      </h2>
      <div class="mt-8">
        <LeadForm sourcePage={`city:${city.slug}`} />
      </div>
    </div>
  </section>
</Layout>
