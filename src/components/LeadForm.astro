---
import { services } from "../data/business";

interface Props {
  sourcePage?: string;
}

const { sourcePage = "unknown" } = Astro.props;
---

<form
  name="lead"
  method="POST"
  action="/thank-you"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="mx-auto max-w-xl space-y-4 rounded-lg border border-black/10 bg-white p-6 text-black shadow-sm"
>
  <input type="hidden" name="form-name" value="lead" />
  <input type="hidden" name="source-page" value={sourcePage} />
  <p class="hidden">
    <label>Don't fill this out if you're human: <input name="bot-field" /></label>
  </p>

  <div>
    <label for="name" class="block text-sm font-medium text-brand-black">Name</label>
    <input
      id="name"
      name="name"
      type="text"
      required
      class="mt-1 w-full rounded-md border border-black/20 px-3 py-2 focus:border-brand-red focus:outline-none"
    />
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for="phone" class="block text-sm font-medium text-brand-black">Phone</label>
      <input
        id="phone"
        name="phone"
        type="tel"
        required
        class="mt-1 w-full rounded-md border border-black/20 px-3 py-2 focus:border-brand-red focus:outline-none"
      />
    </div>
    <div>
      <label for="email" class="block text-sm font-medium text-brand-black">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        class="mt-1 w-full rounded-md border border-black/20 px-3 py-2 focus:border-brand-red focus:outline-none"
      />
    </div>
  </div>

  <div>
    <label for="service" class="block text-sm font-medium text-brand-black">Service Needed</label>
    <select
      id="service"
      name="service"
      class="mt-1 w-full rounded-md border border-black/20 px-3 py-2 focus:border-brand-red focus:outline-none"
    >
      {services.map((s) => <option value={s.name}>{s.name}</option>)}
      <option value="Not sure">Not sure / other</option>
    </select>
  </div>

  <div>
    <label for="message" class="block text-sm font-medium text-brand-black">Details (optional)</label>
    <textarea
      id="message"
      name="message"
      rows="4"
      class="mt-1 w-full rounded-md border border-black/20 px-3 py-2 focus:border-brand-red focus:outline-none"
    ></textarea>
  </div>

  <button
    type="submit"
    class="w-full rounded-md bg-brand-red px-4 py-3 font-semibold text-white transition hover:bg-brand-red-dark"
  >
    Get My Free Quote
  </button>

  <p class="text-center text-xs text-black/50">
    By submitting this form, you agree to receive calls, texts, and/or emails.
  </p>
</form>
