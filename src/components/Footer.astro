---
import { business, services, valueProps } from "../data/business";
import { cities } from "../data/cities";

const currentYear = new Date().getFullYear();
---

<footer class="bg-brand-black text-white">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="text-lg font-bold">{business.brandName}</p>
      <p class="mt-2 text-sm text-white/70">{business.tagline}</p>
      <p class="mt-4 text-sm text-white/70">
        Serving a {business.serviceAreaRadiusMiles}-mile radius around {business.serviceAreaCenter}
      </p>
      <p class="mt-4 text-xs text-white/50">{valueProps.join(" • ")}</p>
    </div>

    <div>
      <p class="font-semibold">Contact</p>
      <ul class="mt-2 space-y-1 text-sm text-white/70">
        <li><a href={business.phoneHref} class="hover:text-white">{business.phoneDisplay}</a></li>
        <li><a href={`mailto:${business.email}`} class="hover:text-white">{business.email}</a></li>
      </ul>
      <p class="mt-4 font-semibold">Hours</p>
      <ul class="mt-2 space-y-1 text-sm text-white/70">
        {business.hours.map((h) => <li>{h.days}: {h.hours}</li>)}
      </ul>
      <p class="mt-2 text-sm text-white/70">Call anytime — we'll get back to you.</p>
    </div>

    <div>
      <p class="font-semibold">Services</p>
      <ul class="mt-2 space-y-1 text-sm text-white/70">
        {services.map((s) => <li><a href={`/services#${s.slug}`} class="hover:text-white">{s.name}</a></li>)}
      </ul>
    </div>

    <div>
      <p class="font-semibold">Service Areas</p>
      <ul class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1 text-sm text-white/70">
        {cities.map((c) => (
          <li><a href={`/service-area/${c.slug}`} class="hover:text-white">{c.name}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10 px-4 py-4 text-center text-xs text-white/50">
    &copy; {currentYear} {business.legalName}. All rights reserved.
  </div>
</footer>
