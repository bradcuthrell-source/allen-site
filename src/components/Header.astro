---
import logo from "../assets/logo/logo-horizontal.png";
import { business } from "../data/business";
import PhoneIcon from "./icons/PhoneIcon.astro";

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/services", label: "Services" },
  { href: "/service-area", label: "Service Areas" },
  { href: "/contact", label: "Contact" },
];
---

<header class="sticky top-0 z-50 border-b border-black/10 bg-[#f4f3f1]/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="flex items-center gap-2">
      <img
        src={logo.src}
        width={logo.width}
        height={logo.height}
        alt={business.brandName}
        class="h-14 w-auto sm:h-16"
      />
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {
        navLinks.map((link) => (
          <a href={link.href} class="font-medium text-brand-black hover:text-brand-red">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={business.phoneHref}
        class="flex items-center gap-2 rounded-md bg-brand-red px-4 py-2 font-semibold text-white transition hover:bg-brand-red-dark"
      >
        <PhoneIcon class="h-4 w-4" />
        <span class="hidden sm:inline">{business.phoneDisplay}</span>
        <span class="sm:hidden">Call Now</span>
      </a>

      <button
        type="button"
        id="menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="inline-flex items-center justify-center rounded-md border border-black/15 p-2 text-brand-black md:hidden"
      >
        <svg
          id="menu-icon-open"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg
          id="menu-icon-close"
          class="hidden"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="6" y1="18" x2="18" y2="6"></line>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="hidden border-t border-black/10 bg-[#f4f3f1] px-4 py-2 md:hidden"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="block border-b border-black/5 py-3 font-medium text-brand-black last:border-0 hover:text-brand-red"
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const nav = document.getElementById("mobile-nav");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");

  if (toggle && nav && iconOpen && iconClose) {
    toggle.addEventListener("click", () => {
      const isOpen = nav.classList.toggle("hidden") === false;
      toggle.setAttribute("aria-expanded", String(isOpen));
      toggle.setAttribute("aria-label", isOpen ? "Close menu" : "Open menu");
      iconOpen.classList.toggle("hidden", isOpen);
      iconClose.classList.toggle("hidden", !isOpen);
    });
  }
</script>
